# Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Application Settings
APP_VERSION=1.0.0
BUILD_ID=local-dev
DEPLOYED_BY=developer

# Security (DO NOT commit actual secrets!)
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/appdb

# APIs
API_KEY=your-api-key-here

# AWS (example - DO NOT use real credentials!)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# VULNERABILITY EXAMPLE (accidentally left in):
# These should NEVER be in version control!
# OLD_DATABASE_URL=postgresql://admin:SuperSecret123@oldserver.com:5432/prod
# LEGACY_API_KEY=sk-1234567890abcdef1234567890abcdef
